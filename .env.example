# Copy to .env (gitignored). Every value here is a secret or machine-specific.
#
# Comments go on their own line. django-environ does NOT strip a trailing `#`
# comment from a value, so `KEY=value  # note` sets KEY to "value  # note" -
# which then fails an adapter lookup with a confusing message.

SECRET_KEY=change-me
DEBUG=true

# DATABASE_URL=sqlite:////absolute/path/on/encrypted/volume/database.sqlite


# ===========================================================================
# Required before anyone can log in
# ===========================================================================

# Who may register at all, comma separated. Empty means NOBODY, deliberately:
# allauth would otherwise let any Google account sign up, which is the wrong
# default for a ledger.
SIGNUP_ALLOWED_EMAILS=vos@example.com

# Encrypts uploaded ARCA private keys at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Set it before uploading a certificate: changing it afterwards strands whatever
# was stored under the old one. It buys a single thing - a database or backup
# copy that leaks without this file leaks no usable key. The encrypted volume
# the database lives on is still the outer defence.
SECRETS_ENCRYPTION_KEY=


# ===========================================================================
# The Google gateway
#
# Two OAuth clients from one Google Cloud project - different *types*, not two
# copies of one. Download the JSON Google offers for each into etc/secrets/;
# nothing is retyped, because a client id is sixty characters of noise and a
# wrong one fails with `invalid_client`, which never says which was mistyped.
#
# The scopes are `spreadsheets` and `drive.file` - the app reaches only what it
# created, which is the whole archive because it makes the folder too. Full
# `drive` is a restricted scope: publishing with it needs a paid yearly security
# assessment, and staying unpublished expires the refresh token every 7 days.
#
#   Web application  the browser gateway. Needs an Authorized *redirect URI*:
#                      http://localhost:8000/accounts/google/login/callback/
#                    A JavaScript origin is a different field and will not do -
#                    allauth redirects server-side. Browse to localhost, never
#                    127.0.0.1: the redirect URI is built from the host you
#                    typed and Google matches it exactly.
#   Desktop app      `scaffolding login`. Consents over a loopback, so it needs no
#                    redirect URI - and cannot take one, which is why it cannot
#                    serve the gateway.
#
# Two registrations, one token store: both end at the same SocialToken row.
# ===========================================================================

# Both default into etc/secrets/; set these only to keep the files elsewhere.
# GOOGLE_OAUTH_WEB_CLIENT=etc/secrets/google-client-web.json
# GOOGLE_OAUTH_DESKTOP_CLIENT=etc/secrets/google-client-secret-cli.json


# ===========================================================================
# ARCA - what this installation talks to
#
# Everything about *who* it talks as - the CUIT, the certificate, the punto de
# venta, the Drive folder - belongs to a taxpayer and lives on their row.
# ===========================================================================

# homologacion | produccion
ARCA_ENV=homologacion

# wsfex (direct to ARCA) | manual (portal bridge) | dry_run (fake CAEs, for tests)
ARCA_AUTHORIZER=manual

# wsfex (ARCA's registered cotización) | manual (the ExchangeRate table)
ARCA_RATE_PROVIDER=manual


# ===========================================================================
# Optional
# ===========================================================================

# Where state lives. In a checkout these default to var/ and etc/secrets/; an
# installed wheel must set them - its defaults would point inside
# site-packages, and an upgrade would wipe the ledger. Point both at a
# directory on the encrypted volume.
# SCAFFOLDING_VAR_DIR=/path/to/encrypted/volume/scaffolding-state
# SCAFFOLDING_SECRETS_DIR=/path/to/encrypted/volume/scaffolding-secrets

# Read by one thing: the test that refuses to let a CUIT be committed. It has to
# know what to look for, and naming it in the test would make the test the place
# it appears. Nothing in the application reads this.
# REDACTED_CUIT=20123456789

# The admin's own password form at /login/. Off by default: Google is the door,
# and `ModelBackend` answering a second one is a second door. Turn it on when
# the OAuth client will not load and a superuser has to get in and fix it.
# ADMIN_PASSWORD_LOGIN=true
