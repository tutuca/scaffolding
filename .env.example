# Copy to .env and fill in. See docs/developer/setup.md.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Keep true for local development only. `conf/serving.py` refuses to serve with
# the default SECRET_KEY unless DEBUG is on.
DEBUG=true

# SQLite by default. Override for another backend:
#   DATABASE_URL=sqlite:///var/database.sqlite
#   TASKS_DATABASE_URL=sqlite:///var/tasks.sqlite
