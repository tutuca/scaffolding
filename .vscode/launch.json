{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "dev ui",
            "command": "npm start",
            "request": "launch",
            "type": "node-terminal"
        },
        {
            "name": "dev server",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "runserver"
            ],
            "cwd": "${workspaceFolder}",
            "django": true,
            "autoStartBrowser": false,
            "program": "src/scaffolding/manage.py"
        }
    ],
    "compounds": [
        {
            "name": "website",
            "configurations": [
                "dev ui",
                "dev server"
            ],
            "stopAll": true
        }
    ]
}
